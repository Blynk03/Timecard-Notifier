<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TimecardNotifier</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.8" PrivateAssets="all" />
  </ItemGroup>

  <!-- Keep Node/Tailwind tooling out of the published app -->
  <ItemGroup>
    <Content Remove="package.json;package-lock.json;tailwind.config.js" />
    <None Include="package.json;tailwind.config.js" />
  </ItemGroup>

  <!--
    Optional: compile Tailwind on every build once you've run `npm install`.
    Without node_modules this target is skipped and the CDN fallback in index.html is used.
  -->
  <Target Name="TailwindBuild" BeforeTargets="Build" Condition="Exists('node_modules/.bin/tailwindcss')">
    <Exec Command="npx tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --minify" />
  </Target>

</Project>
