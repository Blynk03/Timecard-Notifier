@page "/card"
@inject NotifierSettings Settings
@inject DispatchState State
@inject IJSRuntime JS

<PageTitle>Card preview · Timecard Reminders</PageTitle>

<header>
    <h1 class="text-2xl font-semibold text-slate-900" tabindex="-1">Card preview</h1>
    <p class="mt-1 text-sm text-slate-600">
        The adaptive card each person receives in Teams. The wording is a gentle nudge, not an accusation, and the button opens their timecard.
    </p>
</header>

<div class="mt-6 grid gap-4 lg:grid-cols-[360px_1fr]">
    @* ── Editor ─────────────────────────────────────────────── *@
    <section class="card space-y-4 p-5">
        <h2 class="text-sm font-semibold text-slate-900">Message</h2>
        <label class="block">
            <span class="label">Title</span>
            <input class="field" @bind="Settings.CardTitle" @bind:event="oninput" />
        </label>
        <label class="block">
            <span class="label">Body</span>
            <textarea class="field min-h-[120px]" @bind="Settings.CardMessage" @bind:event="oninput"></textarea>
            @if (Settings.CardMessage != NotifierSettings.DefaultMessage)
            {
                <button class="mt-1 text-xs font-medium text-brand-600 hover:underline" @onclick="() => Settings.CardMessage = NotifierSettings.DefaultMessage">
                    Restore approved wording
                </button>
            }
        </label>
        <label class="block">
            <span class="label">Button text</span>
            <input class="field" @bind="Settings.ButtonText" @bind:event="oninput" />
        </label>
        <label class="block">
            <span class="label">Timecard link</span>
            <input class="field font-mono text-xs" @bind="Settings.TimecardUrlTemplate" @bind:event="oninput" />
            <span class="mt-1 block text-xs text-slate-500">
                <code class="rounded bg-slate-100 px-1">{date}</code> = earliest missing workday,
                <code class="rounded bg-slate-100 px-1">{employeeId}</code> = employee ID
            </span>
        </label>

        <div>
            <span class="label">Delivered as</span>
            <div class="grid grid-cols-3 gap-1 rounded-lg bg-slate-100 p-1 text-xs font-medium">
                @foreach (var (value, label) in Channels)
                {
                    <button class="rounded-md px-2 py-1.5 @(Settings.Channel == value ? "bg-white text-slate-900 shadow-sm" : "text-slate-600 hover:text-slate-900")"
                            @onclick="() => Settings.Channel = value">@label</button>
                }
            </div>
        </div>
    </section>

    @* ── Preview ────────────────────────────────────────────── *@
    <section class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="inline-flex rounded-lg bg-white p-1 text-xs font-medium shadow-sm ring-1 ring-slate-200">
                <button class="rounded-md px-3 py-1.5 @(_device == "desktop" ? "bg-slate-900 text-white" : "text-slate-600")" @onclick="@(() => _device = "desktop")">Desktop</button>
                <button class="rounded-md px-3 py-1.5 @(_device == "mobile" ? "bg-slate-900 text-white" : "text-slate-600")" @onclick="@(() => _device = "mobile")">Mobile</button>
            </div>
            <div class="text-xs text-slate-500">Sample recipient · link opens @State.SampleWorkday.ToString("ddd, MMM d")</div>
        </div>

        <div class="grid place-items-center rounded-xl bg-slate-200/60 p-4 sm:p-6">
            <div class="@(_device == "mobile" ? "w-[340px] max-w-full rounded-[28px] border-[6px] border-slate-800" : "w-full rounded-xl border border-slate-300") overflow-hidden bg-[#f5f5f5] shadow-lg">
                @* Teams chrome *@
                <div class="flex items-center gap-2 bg-teams px-4 py-2.5 text-white">
                    <span class="grid h-7 w-7 place-items-center rounded-full bg-white/20"><Icon Name="clock" Class="h-4 w-4" /></span>
                    <div class="text-sm font-semibold">Timecard Bot</div>
                    <div class="ml-auto text-xs text-white/80">Microsoft Teams</div>
                </div>

                @if (Settings.Channel != DeliveryChannel.ChatMessage)
                {
                    <div class="border-b border-slate-200 bg-white px-4 py-3">
                        <div class="mb-2 flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                            <Icon Name="bell" Class="h-3.5 w-3.5" /> Activity
                        </div>
                        <div class="flex items-start gap-3 rounded-md bg-teams-light/60 p-2.5">
                            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-teams"></span>
                            <div class="min-w-0 text-sm">
                                <div><span class="font-semibold text-slate-900">Timecard Bot</span> <span class="text-slate-600">sent you a reminder</span></div>
                                <div class="truncate text-slate-600">@Settings.CardTitle: @Settings.CardMessage</div>
                                <div class="mt-0.5 text-xs text-slate-500">9:02 AM</div>
                            </div>
                        </div>
                    </div>
                }

                @if (Settings.Channel != DeliveryChannel.ActivityFeed)
                {
                    <div class="px-4 py-5">
                        <div class="mb-1.5 flex items-baseline gap-2 text-xs">
                            <span class="font-semibold text-slate-800">Timecard Bot</span>
                            <span class="text-slate-500">9:02 AM</span>
                        </div>
                        <AdaptiveCardPreview Settings="Settings" Workday="State.SampleWorkday" Compact="@(_device == "mobile")" />
                    </div>
                }
                else
                {
                    <div class="px-4 py-6 text-center text-xs text-slate-500">
                        Activity-only: tapping the notification opens the card in the bot's chat.
                    </div>
                }
            </div>
        </div>

        <details class="card overflow-hidden" open="@_jsonOpen">
            <summary class="flex cursor-pointer items-center justify-between px-5 py-3 text-sm font-semibold text-slate-900" @onclick="() => _jsonOpen = !_jsonOpen" @onclick:preventDefault>
                Adaptive Card JSON (hand this to the back end)
                <span class="text-xs font-normal text-slate-500">@(_jsonOpen ? "Hide" : "Show")</span>
            </summary>
            <div class="relative border-t border-slate-200 bg-slate-900">
                <button class="absolute right-3 top-3 rounded-md bg-white/10 px-2.5 py-1 text-xs font-medium text-white hover:bg-white/20" @onclick="CopyJson">
                    @(_copied ? "Copied" : "Copy")
                </button>
                <pre class="max-h-96 overflow-auto p-5 font-mono text-xs leading-relaxed text-slate-100">@CardJson</pre>
            </div>
        </details>
    </section>
</div>

@code {
    private string _device = "desktop";
    private bool _jsonOpen;
    private bool _copied;

    private static readonly (DeliveryChannel Value, string Label)[] Channels =
    {
        (DeliveryChannel.ChatMessage, "Chat"),
        (DeliveryChannel.ActivityFeed, "Activity"),
        (DeliveryChannel.Both, "Both"),
    };

    private string CardJson => AdaptiveCardBuilder.BuildJson(Settings, State.SampleWorkday);

    private async Task CopyJson()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", CardJson);
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }
}
